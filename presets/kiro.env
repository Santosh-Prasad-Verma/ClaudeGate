# Preset: Kiro Gateway (Amazon Q Developer / AWS CodeWhisperer Bridge)
# Start Kiro Gateway on port 8000 (cd /home/tarun/kiro-gateway && python main.py)
OPENAI_API_KEY="kiro"
OPENAI_BASE_URL="http://127.0.0.1:8000/v1"
BIG_MODEL="claude-sonnet-4.5"
MIDDLE_MODEL="claude-sonnet-4.5"
SMALL_MODEL="claude-haiku-4.5"
HOST="127.0.0.1"
PORT="8082"
LOG_LEVEL="INFO"
ANTHROPIC_API_KEY="sk-claudegate-local"
REQUEST_TIMEOUT="180"
MAX_TOKENS_LIMIT="8192"

# Optional Failover: If Amazon Q runs out of quota, auto-fallback to OpenRouter/Groq
FALLBACK_BASE_URL="https://openrouter.ai/api/v1"
FALLBACK_API_KEY="sk-or-v1-YOUR_OPENROUTER_KEY"
FALLBACK_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
