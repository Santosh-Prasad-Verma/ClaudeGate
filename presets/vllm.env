# Preset: vLLM (High-throughput Self-Hosted GPU Engine)
# Start vLLM with: python -m vllm.entrypoints.openai.api_server --port 8000
OPENAI_API_KEY="vllm"
OPENAI_BASE_URL="http://localhost:8000/v1"
BIG_MODEL="Qwen/Qwen2.5-Coder-32B-Instruct"
MIDDLE_MODEL="Qwen/Qwen2.5-Coder-32B-Instruct"
SMALL_MODEL="Qwen/Qwen2.5-Coder-7B-Instruct"
HOST="127.0.0.1"
PORT="8082"
LOG_LEVEL="INFO"
ANTHROPIC_API_KEY="sk-claudegate-local"
REQUEST_TIMEOUT="180"
MAX_TOKENS_LIMIT="8192"
