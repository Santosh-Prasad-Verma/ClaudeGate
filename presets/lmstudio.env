# Preset: LM Studio (Local Desktop LLM Runtime)
# Start local server in LM Studio on default port 1234
OPENAI_API_KEY="lm-studio"
OPENAI_BASE_URL="http://localhost:1234/v1"
BIG_MODEL="qwen2.5-coder-32b-instruct"
MIDDLE_MODEL="qwen2.5-coder-14b-instruct"
SMALL_MODEL="qwen2.5-coder-7b-instruct"
HOST="127.0.0.1"
PORT="8082"
LOG_LEVEL="INFO"
ANTHROPIC_API_KEY="sk-claudegate-local"
REQUEST_TIMEOUT="180"
MAX_TOKENS_LIMIT="8192"
