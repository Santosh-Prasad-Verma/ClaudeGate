# ==============================================================================
# OPENAI_API_KEY="YOUR_AZURE_OPENAI_KEY"
# OPENAI_BASE_URL="https://YOUR_RESOURCE_NAME.openai.azure.com"
# AZURE_API_VERSION="2024-02-15-preview"
# BIG_MODEL="gpt-5.6-sol"
# MIDDLE_MODEL="gpt-5.6-terra"
# SMALL_MODEL="gpt-5.6-luna"


# ==============================================================================
# [25] KIRO GATEWAY (AWS Amazon Q Developer / CodeWhisperer Bridge)
# ==============================================================================
# OPENAI_API_KEY="kiro"
# OPENAI_BASE_URL="http://127.0.0.1:8000/v1"
# BIG_MODEL="claude-opus-5"
# MIDDLE_MODEL="claude-sonnet-5"
# SMALL_MODEL="claude-haiku-4.5"


# ==============================================================================
# AUTOMATIC MULTI-PROVIDER FAILOVER (Optional)
# ==============================================================================
# If your primary upstream triggers 500, 503, or 429 overloads, ClaudeGate
# automatically falls back to this provider without interrupting your active session.
# FALLBACK_BASE_URL="https://api.groq.com/openai/v1"
# FALLBACK_API_KEY="gsk_YOUR_GROQ_KEY"
# FALLBACK_MODEL="deepseek-v4-pro"


# ==============================================================================
# COMMON GATEWAY NETWORK & SECURITY SETTINGS
# ==============================================================================
# Bind IP: '127.0.0.1' (Secure local only) or '0.0.0.0' (Expose to Docker/LAN)
HOST="127.0.0.1"
PORT="8082"

# Authentication key required from Claude Code CLI / Anthropic SDK
ANTHROPIC_API_KEY="sk-claudegate-local"

# Set to true only for local insecure development without client keys
ALLOW_ANONYMOUS_ACCESS="false"

# Rate Limiting & Concurrency Controls
RATE_LIMIT_PER_MINUTE="120"
MAX_CONCURRENT_REQUESTS="30"

# CORS Allowed Origins
ALLOWED_ORIGINS="http://localhost:8082,http://127.0.0.1:8082,http://localhost:3000,http://127.0.0.1:3000"

# Automatic Secret Redaction Engine (Sanitizes outgoing LLM prompts)
SANITIZE_SECRETS="false"


# ==============================================================================
# PERFORMANCE, RESILIENCE & TIME-OUTS
# ==============================================================================
LOG_LEVEL="INFO"
REQUEST_TIMEOUT="180"
MAX_TOKENS_LIMIT="8192"
MIN_TOKENS_LIMIT="100"
TIMEOUT_KEEP_ALIVE="600"
