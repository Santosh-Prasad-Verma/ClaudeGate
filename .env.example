# ==============================================================================
#  ClaudeGate Universal Provider & Model Configuration Matrix
# ==============================================================================
# Instructions:
# 1. Choose ONE provider template below and UNCOMMENT its block.
# 2. Insert your provider API key.
# 3. Save as `.env` (or run `python start_proxy.py --setup` for interactive wizard).
# ==============================================================================


# ==============================================================================
# [1] STEALTH OX ALPHA (via OpenRouter) [ACTIVE DEFAULT]
# ==============================================================================
OPENAI_API_KEY="sk-or-v1-YOUR_OPENROUTER_KEY"
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
BIG_MODEL="stealth/ox-alpha"
MIDDLE_MODEL="stealth/ox-alpha"
SMALL_MODEL="stealth/ox-alpha"


# ==============================================================================
# [2] ANTHROPIC CLAUDE 5 (via OpenRouter)
# ==============================================================================
# OPENAI_API_KEY="sk-or-v1-YOUR_OPENROUTER_KEY"
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# BIG_MODEL="anthropic/claude-opus-5"
# MIDDLE_MODEL="anthropic/claude-sonnet-5"
# SMALL_MODEL="anthropic/claude-haiku-4.5"


