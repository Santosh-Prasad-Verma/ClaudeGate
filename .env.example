# OPENAI_BASE_URL="http://localhost:1234/v1"
# BIG_MODEL="deepseek-v4-pro"
# MIDDLE_MODEL="qwen3.6-35b-a3b"
# SMALL_MODEL="muse-glimmer"


# ==============================================================================
# [23] vLLM (High-Throughput Self-Hosted GPU Cluster)
# ==============================================================================
# Start vLLM with: python -m vllm.entrypoints.openai.api_server --port 8000
# OPENAI_API_KEY="vllm"
# OPENAI_BASE_URL="http://localhost:8000/v1"
# BIG_MODEL="deepseek-ai/DeepSeek-V4-Pro"
# MIDDLE_MODEL="Qwen/Qwen3.6-35B-A3B"
# SMALL_MODEL="meta/Muse-Glimmer"


# ==============================================================================
