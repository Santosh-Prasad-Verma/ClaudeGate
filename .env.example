# ==============================================================================
#  ClaudeGate Universal Configuration Matrix
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# Or run the interactive setup wizard:
#   python start_proxy.py --setup
# ==============================================================================

# ==============================================================================
# 1. UPSTREAM PROVIDER CREDENTIALS & BASE URL
# ==============================================================================
# Your upstream API key (OpenRouter, Groq, DeepSeek, OpenAI, Gemini, etc.)
# (For local Ollama / LM Studio / vLLM, you can use any dummy string like 'ollama')
OPENAI_API_KEY="your-api-key-here"

# Upstream OpenAI-compatible API base URL
# ------------------------------------------------------------------------------
# Popular Provider Base URLs:
#   • OpenRouter:       https://openrouter.ai/api/v1
#   • Groq:             https://api.groq.com/openai/v1
#   • DeepSeek:         https://api.deepseek.com/v1
#   • Google Gemini:    https://generativelanguage.googleapis.com/v1beta/openai
#   • Mistral AI:       https://api.mistral.ai/v1
#   • OpenAI Official:  https://api.openai.com/v1
#   • Together AI:      https://api.together.xyz/v1
#   • Fireworks AI:     https://api.fireworks.ai/inference/v1
#   • Cerebras AI:      https://api.cerebras.ai/v1
#   • SambaNova Cloud:  https://api.sambanova.ai/v1
#   • Perplexity AI:    https://api.perplexity.ai
#   • Cohere AI:        https://api.cohere.ai/v1
#   • SiliconFlow:      https://api.siliconflow.cn/v1
#   • Local Ollama:     http://localhost:11434/v1
#   • Local LM Studio:  http://localhost:1234/v1
#   • Local vLLM:       http://localhost:8000/v1
#   • Azure OpenAI:     https://YOUR_RESOURCE.openai.azure.com
OPENAI_BASE_URL="https://openrouter.ai/api/v1"

# Optional: Azure OpenAI API version (only required when using Azure)
# AZURE_API_VERSION="2024-02-15-preview"


# ==============================================================================
# 2. MODEL MAPPING MATRIX (BIG, MIDDLE, SMALL TIERS)
# ==============================================================================
# Maps incoming Claude Code model requests to your upstream provider's model IDs:
#   • BIG_MODEL:    Triggered when Claude Code requests Claude Opus or Claude 3.7
#   • MIDDLE_MODEL: Triggered when Claude Code requests Claude Sonnet 3.5 / 3.7
#   • SMALL_MODEL:  Triggered when Claude Code requests Claude Haiku
# ------------------------------------------------------------------------------

# --- [A] OPENROUTER PRESETS ---
# Free Tier Models:
# BIG_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
# MIDDLE_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
# SMALL_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
#
# Paid Frontier Models:
# BIG_MODEL="deepseek/deepseek-r1"
# MIDDLE_MODEL="anthropic/claude-3.7-sonnet"
# SMALL_MODEL="google/gemini-2.0-flash-001"

# --- [B] GROQ PRESETS (Ultra-fast Cloud) ---
# BIG_MODEL="llama-3.3-70b-versatile"
# MIDDLE_MODEL="llama-3.3-70b-versatile"
# SMALL_MODEL="llama-3.1-8b-instant"

# --- [C] DEEPSEEK OFFICIAL PRESETS ---
# BIG_MODEL="deepseek-reasoner"
# MIDDLE_MODEL="deepseek-chat"
# SMALL_MODEL="deepseek-chat"

# --- [D] GOOGLE GEMINI PRESETS ---
# BIG_MODEL="gemini-2.0-pro-exp-02-05"
# MIDDLE_MODEL="gemini-2.0-flash"
# SMALL_MODEL="gemini-2.0-flash-lite-preview-02-05"

# --- [E] MISTRAL AI PRESETS ---
# BIG_MODEL="mistral-large-latest"
# MIDDLE_MODEL="codestral-latest"
# SMALL_MODEL="ministral-8b-latest"

# --- [F] OPENAI OFFICIAL PRESETS ---
# BIG_MODEL="o1"
# MIDDLE_MODEL="gpt-4o"
# SMALL_MODEL="gpt-4o-mini"

# --- [G] OLLAMA / LOCAL PRESETS ---
# BIG_MODEL="qwen2.5-coder:32b"
# MIDDLE_MODEL="qwen2.5-coder:14b"
# SMALL_MODEL="qwen2.5-coder:7b"

# Active Defaults (OpenRouter Free Tier):
BIG_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
MIDDLE_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
SMALL_MODEL="nvidia/nemotron-3-super-120b-a12b:free"


# ==============================================================================
# 3. GATEWAY NETWORK, PORTS & SECURITY
# ==============================================================================
# Bind IP:
#   • '127.0.0.1' - Secure Local Only (Prevents other LAN devices from accessing)
#   • '0.0.0.0'   - Expose to Docker / Local Network
HOST="127.0.0.1"
PORT="8082"

# Expected client key sent by Claude Code CLI / Anthropic SDK
# (Configure in ~/.claude/settings.json or via ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY="sk-claudegate-local"

# Set to true only for local insecure development without client keys
ALLOW_ANONYMOUS_ACCESS="false"

# Rate Limiting & Concurrency Controls
RATE_LIMIT_PER_MINUTE="120"
MAX_CONCURRENT_REQUESTS="30"

# CORS Allowed Origins (Comma-separated list of permitted browser origins)
ALLOWED_ORIGINS="http://localhost:8082,http://127.0.0.1:8082,http://localhost:3000,http://127.0.0.1:3000"

# Automatic Credential & Secret Redaction (Sanitizes outgoing LLM prompts)
SANITIZE_SECRETS="false"


# ==============================================================================
# 4. PERFORMANCE, RESILIENCE & TIME-OUTS
# ==============================================================================
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"

# Maximum wait time for upstream model response generation (in seconds)
REQUEST_TIMEOUT="120"

# Generation token bounds
MAX_TOKENS_LIMIT="8192"
MIN_TOKENS_LIMIT="100"

# Keep-alive timeout for HTTP connections in seconds (prevents ECONNRESET)
TIMEOUT_KEEP_ALIVE="600"
